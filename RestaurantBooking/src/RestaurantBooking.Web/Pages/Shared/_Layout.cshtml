<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - რესტორნის ჯავშანი</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" asp-page="/Index">🍽 რესტორანი</a>
        <ul class="navbar-nav me-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item"><a class="nav-link" asp-page="/Reservations/Create">დაჯავშნა</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Reservations/Index">ჩემი ჯავშნები</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Reservations">ადმინი</a></li>
                }
            }
        </ul>
        <ul class="navbar-nav align-items-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item text-light me-3">@User.Identity.Name</li>
                <li class="nav-item">
                    <form method="post" asp-page="/Account/Logout">
                        <button class="btn btn-outline-light btn-sm">გამოსვლა</button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">შესვლა</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">რეგისტრაცია</a></li>
            }
        </ul>
    </div>
</nav>
<main class="container py-4">
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
